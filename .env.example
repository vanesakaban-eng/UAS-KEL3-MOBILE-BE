# Server Port (Default 5001 agar selaras dengan Mobile Flutter & Web Admin)
PORT=5001
MOBILE_PORT=5001

# Konfigurasi Database Relasional (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_uku

# Keamanan Token Autentikasi JWT
JWT_SECRET=uku_super_secret_jwt_key_2026_secured_with_role_based_access_control

# Google Gemini AI API Key
# Dapatkan gratis di: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Konfigurasi Email SMTP (Nodemailer untuk OTP Verifikasi & Reset Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UKu Financial <no-reply@uku.id>
SMTP_SECURE=false
